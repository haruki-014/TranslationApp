# docker compose が自動で読み込みます（cp .env.example .env）
# ここに書いた値で docker-compose.yml の ${変数:-既定値} が上書きされます。

# モデルサーバー（OpenAI 互換 API）の URL。
#   MLX 版 PLaMo（mlx-server/start.sh）: http://host.docker.internal:8001/v1
#   LM Studio のローカルサーバー        : http://host.docker.internal:1234/v1
# host.docker.internal はコンテナから見た「この Mac」を指します。
LMSTUDIO_BASE_URL=http://host.docker.internal:8001/v1

# 既定モデル。空ならモデル一覧から "plamo" を含むものを自動選択
DEFAULT_MODEL=

# 生成の上限トークン数 / 温度（0 のときは同一条件の翻訳結果を Redis にキャッシュ）
MAX_TOKENS=2048
TEMPERATURE=0

# 翻訳時に参考として渡す直近の対訳ペア数（多いほど用語が揃うが、遅くなる）
HISTORY_PAIRS=4

# PFML3 プロンプト先頭に <|plamo:bos|> を自前で付けるか（サーバーが自動付与しない場合のみ true）
PLAMO_ADD_BOS=false

# ホストに公開するポート（どちらも 127.0.0.1 にだけ公開されます）
FRONTEND_PORT=3000
BACKEND_PORT=8000
